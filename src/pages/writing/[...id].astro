---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft && !data.file);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const typeLabels: Record<string, string> = {
  'technical-note': 'Technical note',
  'research-thought': 'Research thought',
  'presentation': 'Presentation',
  'paper': 'Paper',
  'class-note': 'Class note',
  'misc': 'Misc.',
};
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="reading page-header prose">
    <a class="muted" href="/writing">← Writing</a>
    <div class={`writing-type type-${post.data.type}`} style="margin-top: 28px">{typeLabels[post.data.type]}</div>
    <h1 class="page-title" style="margin-top: 10px">{post.data.title}</h1>
    <div class="post-meta">
      {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
      {post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}
    </div>
    <Content />
  </article>
</BaseLayout>
