---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const items = (await getCollection('engagement'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const typeLabels: Record<string, string> = {
  profile: 'Profile',
  news: 'News',
  talk: 'Talk',
  video: 'Video',
  interview: 'Interview',
  podcast: 'Podcast',
  social: 'Social',
  other: 'Other',
};
---

<BaseLayout title="Engagement">
  <div class="container page-header">
    <div class="eyebrow">Outreach · Media · Talks</div>

    <h1 class="page-title">Engagement</h1>

    <p>
      Talks, profiles, interviews and other places where I discuss my work
      beyond research papers.
    </p>
  </div>

  <section style="padding-top: 18px">
    <div class="container">
      <div class="engagement-list">
        {items.map((item) => (
          <a
            href={item.data.url}
            target="_blank"
            rel="noreferrer"
          >
            <time>
              {item.data.date.toLocaleDateString('en-GB', {
                month: 'short',
                year: 'numeric',
              })}
            </time>

            <div class="engagement-copy">
              <div class={`engagement-type type-${item.data.type}`}>
                {typeLabels[item.data.type]}
              </div>

              <h3>{item.data.title}</h3>

              <div class="muted">
                <strong>{item.data.source}</strong>
                {item.data.description && (
                  <> · {item.data.description}</>
                )}
              </div>
            </div>

            <span class="arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>